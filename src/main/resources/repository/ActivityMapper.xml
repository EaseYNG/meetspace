<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.venus.meetspace.repository.ActivityMapper">

    <select id="findByConditions" resultType="com.venus.meetspace.model.entity.Activity">
        SELECT * FROM activity
        WHERE status = 'READY'
        <if test="startTime != null">
            AND start_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            AND end_time &lt;= #{endTime}
        </if>
        <if test="minParticipants != null">
            AND min_participants &gt;= #{minParticipants}
        </if>
        <if test="maxParticipants != null">
            AND max_participants &lt;= #{maxParticipants}
        </if>
        <if test="longitude != null and latitude != null and radius != null">
            AND ST_Distance_Sphere(
                POINT(longitude, latitude),
                POINT(#{longitude}, #{latitude})
            ) &lt;= #{radius} * 1000
        </if>
    </select>

    <select id="findAllReady" resultType="com.venus.meetspace.model.entity.Activity">
        SELECT * FROM activity WHERE status = 'READY'
    </select>

    <select id="findAllByIds" resultType="com.venus.meetspace.model.entity.Activity">
        SELECT * FROM activity WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectAllIds" resultType="Long">
        SELECT id FROM activity
    </select>

</mapper>
