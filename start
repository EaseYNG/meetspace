#!/bin/bash
set -e

echo "========================================"
echo "  MeetSpace - 启动脚本"
echo "========================================"
echo ""

# 启动 Redis
echo "[1/3] 启动 Redis..."
redis-server --daemonize yes 2>/dev/null || redis-server &
echo "  Redis 已启动"

# 启动 Elasticsearch
echo "[2/3] 启动 Elasticsearch..."
elasticsearch -d -p /tmp/meetspace-es.pid 2>/dev/null &
echo "  Elasticsearch 启动中（约需15-30秒）..."

# 等待 ES 就绪
echo -n "  等待 Elasticsearch 就绪"
until curl -s -o /dev/null http://localhost:9200 2>/dev/null; do
  echo -n "."
  sleep 3
done
echo ""
echo "  Elasticsearch 已就绪"

# 启动应用
echo "[3/3] 启动 MeetSpace 应用..."
echo ""
./mvnw spring-boot:run
